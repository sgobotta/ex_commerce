# Database
export DB_USERNAME=postgres
export DB_PASSWORD=postgres
export DB_DATABASE=ex_commerce_dev
export DB_HOSTNAME=localhost

# Cache service
export REDIS_PASS=123456

# Cloudex
export CLOUDEX_API_KEY=XXXXXXXXXXXXXXX
export CLOUDEX_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXX
export CLOUDEX_CLOUD_NAME=xxxxxxxxx

# Misc
export UPLOADS_PATH=priv/static/uploads

# ReCAPTCHA
