<%= link to: Routes.brand_index_path(ExCommerceWeb.Endpoint, :index),
  class: "
    flex p-2 sm:px-4 rounded-full
    uppercase text-base font-medium text-white
    bg-sky-500 hover:bg-sky-400 focus:bg-sky-500 active:bg-sky-500
    pressable with-outline-sm gray
  "
do %>
  <div class="inline-flex items-center">
    <.icon name={:home} class="block md:hidden text-white w-6 h-6"/>
    <span class="hidden md:block px-1"><%= gettext("Admin")  %></span>
  </div>
<% end %>
