<div class="l-centered h-screen bg-gray-200">
  <div class="card light">
    <%= form_for @conn, Routes.user_session_path(@conn, :create), [as: :user, class: "m-0"], fn f -> %>
      <%= if @error_message do %>
        <div class="alert alert-danger alert-form">
          <p><%= @error_message %></p>
        </div>
      <% end %>

      <%= label f, :email, gettext("Enter your email"), class: "my-2" %>
      <%= email_input f, :email, required: true, placeholder: gettext("Email"), class: "user-form input" %>

      <%= label f, :password, gettext("Enter your password"), class: "my-2" %>
      <%= password_input f, :password, required: true, placeholder: gettext("Password"), class: "user-form input" %>

      <div class="flex items-center justify-between my-2">
        <%= label f, :remember_me, gettext("Keep me logged in for 60 days"), class: "mt-2 text-xl font-normal" %>
        <%= checkbox f, :remember_me, class: "checkbox mx-2" %>
      </div>

      <%= raw Recaptcha.Template.display() %>

      <div class="flex justify-end my-6">
        <%= submit gettext("Log in"), class: "button with-outline-sm" %>
      </div>

      <div class="flex content-center justify-evenly">
        <%= link gettext("Register"), to: Routes.user_registration_path(@conn, :new), class: "user-form link" %>
        <%= link gettext("Forgot your password?"), to: Routes.user_reset_password_path(@conn, :new), class: "user-form link" %>
      </div>
    <% end %>
  </div>
</div>
