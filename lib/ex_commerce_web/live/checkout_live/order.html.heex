<%= if @live_action in [:cart] do %>
  <%= live_modal @socket, ExCommerceWeb.CheckoutLive.Components.CartComponent,
    id: Ecto.UUID.generate(),
    title: @page_title,
    action: @live_action,
    return_to: @return_to,
    patch_to: @return_to,
    redirect_to: @redirect_to,
    current_route: @return_to,
    opts: %{
      cart: @cart,
      content_classes: "mt-12"
    }
  %>
<% end %>

<div class="flex flex-col h-full">
  <div class="
    basis-1/4 flex flex-col w-full justify-center items-center shrink-0
  " />
  <div class="flex items-end basis-2/4 self-center w-full sm:w-full md:w-10/12 lg:w-10/12 xl:w-2/3">
    <LiveMotion.motion
      id="item-content"
      initial={[y: [1000]]}
      animate={[y: [0]]}
      transition={[]}
      exit={[y: [1000]]}
      class="h-full w-full"
    >
      <div class={"z-50 bg-transparent h-full"}>
        <div class={"
          bg-white
          border-t-4 border-gray-200
          rounded-t-5xl shadow-button
          h-full
        "}>
          <div class="flex justify-center py-2">
            <div class="rounded-sm self-center shadow-inner bg-gray-300 h-1 w-16" />
          </div>

          <div class="pt-6 px-8">
            <div class="grid grid-cols-6">
              <div class="col-span-6 sm:col-span-5">
                <div class="mb-4">
                  <h1 class="mt-1 text-2xl text-sky-500 font-medium">
                    <%= gettext("Confirm your order") %>
                  </h1>
                </div>
              </div>
            </div>
          </div>

          <div class="basis-full bg-gray-100 h-full px-6 pb-40">
            <%= form_for @changeset, "#", [
              id: "order-form",
              class: "mb-0"
            ], fn f -> %>

              <%= label f, :buyer_name, gettext("Name"), class: "p-2 text-sky-600 text-xl" %>
              <%= text_input f, :buyer_name,
                disabled: true,
                class: "disabled-input text-gray-500 shadow-button",
                placeholder: gettext("Enter your name") %>
              <%= error_tag f, :buyer_name %>

              <%= label f, :address, gettext("Address"), class: "p-2 text-sky-600 text-xl" %>
              <%= text_input f, :address,
                disabled: true,
                class: "disabled-input text-gray-500 shadow-button",
                placeholder: gettext("Enter your address") %>
              <%= error_tag f, :address %>

              <%= label f, :note, class: "p-2 text-sky-600 text-xl" %>
              <%= textarea f, :note,
                disabled: true,
                class: "disabled-input text-gray-500 shadow-button",
                placeholder: gettext("Enter notes for the market") %>
              <%= error_tag f, :note %>

            <% end %>

            <div class="flex flex-row">
              <div class="pt-1">
                <.icon name={:information_circle} outlined class="
                  text-gray-500
                  flex-shrink-0 h-4 w-4
                "/>
              </div>
              <div class="">
                <p class="text-base text-gray-500 italic">
                  <%= gettext("Click Confirm to send a message to the Shop with your order details.") %>
                  <%= gettext("You will be able to check the status once the order is accepted by the shop.") %>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </LiveMotion.motion>
  </div>  

  <LiveMotion.motion
    id="checkout-button"
    initial={[y: [400]]}
    animate={[y: [0]]}
    transition={[]}
    exit={[y: [400]]}
    class="
      fixed bottom-4 flex justify-center px-4
      max-w-7xl w-full z-50
    "
  >
    <.live_component
      module={Components.FloatingButton}
      id="checkout-button"
      enabled={valid_checkout?(@changeset, @cart)}
      on_click_event="confirm_order"
    >
      <:enabled_content>
        <a data-confirm={gettext("Send order?")} href={@href} target="_blank">
          <div class="flex flex-row">
            <div class="px-2">
              <p class="font-medium text-white">
                (<%= get_order_items(@cart) %>)
              </p>
            </div>
            <div class="px-2">
              <p class="font-medium text-white">
                <%= get_order_price(@cart) %>
              </p>
            </div>
            <div class="px-2">
              <p class="font-medium text-white">
                <%= get_button_text(@changeset, @cart) %>
              </p>
            </div>
            <div class="pt-1">
              <.icon name={:shopping_bag} outlined class="
                text-white
                flex-shrink-0 h-7 w-7
              "/>
            </div>
          </div>
        </a>
      </:enabled_content>

      <:disabled_content>
        <div class="flex flex-row">
          <div class="px-2">
            <p class="font-medium text-white text-center">
              <%= get_button_text(@changeset, @cart) %>
            </p>
          </div>
          <div class="pt-1 self-center">
            <.icon name={:shopping_bag} outlined class="
              pr-2
              text-white
              flex-shrink-0 h-7 w-7
            "/>
          </div>
        </div>
      </:disabled_content>
    </.live_component>
  </LiveMotion.motion>
</div>
