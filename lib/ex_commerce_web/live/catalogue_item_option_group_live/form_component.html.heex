<div>
  <div class="px-4">
    <.title_bar title={@title} />
  </div>

  <div class="px-2 sm:px-6 py-2">
    <%= form_for @changeset, "#", [
        id: "catalogue_item_option_group-form",
        phx_target: @myself,
        phx_change: "validate",
        phx_submit: "save",
        class: "mb-0"
      ],
      fn f -> %>

      <%= label f, :code, gettext("Code"), class: "my-2" %>
      <%= text_input f, :code, class: "input light-bg", placeholder: gettext("An internal code: SNACKS-00 / DRINKS-00") %>
      <%= error_tag f, :code %>

      <%= label f, :name, gettext("Name"), class: "my-2" %>
      <%= text_input f, :name, class: "input light-bg", placeholder: gettext("Accompanying sauces | Budget requirements") %>
      <%= error_tag f, :name %>

      <%= label f, :description, gettext("Description"), class: "my-2" %>
      <%= text_input f, :description, class: "input light-bg", placeholder: gettext("Select one or more of the following") %>
      <%= error_tag f, :description %>

      <div class="flex flex-wrap mx-1 overflow-hidden">
        <div class="px-1 w-2/6 self-center">
          <div class="flex items-center p-2">
            <%= checkbox f, :mandatory, class: "checkbox mx-2" %>
            <%= label f, :mandatory, gettext("Required"), class: "my-2" %>
          </div>
          <%= error_tag f, :mandatory %>
        </div>

        <div class="px-1 w-2/6 self-center">
          <div class="flex items-center p-2">
            <%= checkbox f, :multiple_selection, class: "checkbox mx-2" %>
            <%= label f, :multiple_selection, gettext("Multiple selection"), class: "my-2" %>
          </div>
          <%= error_tag f, :multiple_selection %>
        </div>

        <div class="p-1 w-2/6 self-center">
          <%= label f, :max_selection, gettext("Maximum selection"), class: "my-2" %>
          <%= number_input f, :max_selection, class: "input light-bg", placeholder: gettext("How many options can be selected.") %>
          <%= error_tag f, :max_selection %>
        </div>
      </div>

      <div class="border-b-1 border-gray-300 my-3">
        <p class="mt-4 mb-2 user-form section-subtitle"><%= gettext("Options") %></p>
        <p class="pb-2 text-lg form-field-description">
          <%= gettext("Create one or more options to your options group. For example: a Group of drink options that can then be assigned to accompany any other Item.") %>
        </p>
        <div class="flex flex-row">
          <div class="pt-1">
            <.icon name={:information_circle} outlined class="
              text-gray-500
              flex-shrink-0 h-4 w-4
            "/>
          </div>
          <div class="">
            <p class="form-field-hint">
              <%= gettext("An Option Group can be assigned to multiple items so that you don't have to recreate options for each of your offered Items.") %>
            </p>
          </div>
        </div>
      </div>

      <div class="">
        <%= inputs_for f, :options, fn o -> %>
          <div class="card p-2 my-4">
            <div class="flex flex-col sm:flex-row">
              <div class="flex flex-col">
                <div class="">
                  <label class=""><%= gettext("Catalogue Item") %></label>
                  <%=
                    options = build_catalogue_item_options(@catalogue_items)
                    select o, :catalogue_item_id, options,
                      prompt: get_catalogue_items_prompt(options, o),
                      selected: get_selected_catalogue_item(options),
                      disabled: is_catalogue_item_disabled(options),
                      class: "w-full input px-4 light-bg"
                  %>
                  <%= error_tag o, :catalogue_item_id %>
                </div>

                <div class="my-2">
                  <label class=""><%= gettext("Item Variant") %></label>
                  <%=
                    options = get_catalogue_item_variant_options(
                      @changeset,
                      @catalogue_items,
                      o
                    )
                    select o, :catalogue_item_variant_id, options,
                      prompt: get_catalogue_item_variant_prompt(options, o),
                      selected: nil,
                      disabled: is_catalogue_item_variant_disabled(options, o),
                      class: "w-full input light-bg px-4"
                  %>
                  <%= error_tag o, :catalogue_item_variant_id %>
                </div>
              </div>
              <div class="
                flex flex-row sm:flex-col items-center sm:items-stretch sm:justify-between
                sm:mx-1 my-2
              ">
                <label class="basis-1/3"><%= gettext("Discount %") %></label>
                <div class="basis-1/3 mx-1 sm:mb-1">
                  <%= number_input o, :price_modifier,
                        step: 1,
                        min: 0,
                        max: 100,
                        class: "input light-bg"
                  %>
                  <%= error_tag o, :price_modifier %>
                </div>
                <div class="basis-1/3 mx-1">
                  <%= number_input o, :price_preview, class: "disabled-input darker", disabled: true %>
                  <%= error_tag o, :price_preview %>
                </div>
              </div>
            </div>
            <div class="flex flex-row">
              <div class="inline-flex basis-1/2">
                <label class=""><%= gettext("Visible?") %></label>
                <%= checkbox o, :is_visible, class: "checkbox mx-2" %>
                <%= error_tag o, :is_visible %>
              </div>
              <div class="inline-flex basis-1/2 justify-end">
                <%= if is_nil(o.data.temp_id) do %>
                  <label class=""><%= gettext("Mark as deleted?") %></label>
                  <%= checkbox o, :delete, class: "checkbox warn mx-2" %>
                <% else %>
                  <%= hidden_input o, :temp_id %>
                  <a
                    class="mx-2 rounded-lg"
                    href="#"
                    phx-click="remove_option"
                    phx-value-remove={o.data.temp_id}
                    phx-target={@myself}
                  >
                    <.icon name={:trash} outlined class="
                      text-rose-500
                      flex-shrink-0 h-8 w-8
                    "/>
                  </a>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>

        <div class="flex justify-start mt-6">
          <a
            href="#"
            phx-click="add_option"
            phx-target={@myself}
            class="button"
            id="catalogue_item-add-option-input"
          >
            <%= gettext("Add an option") %>
          </a>
        </div>
      </div>

      <div class="border-b-1 border-gray-300 my-3">
        <p class="mt-4 mb-2 user-form section-subtitle"><%= gettext("Assign to Items") %> (<%= gettext("Optional") %>)</p>
        <div class="flex flex-row">
          <div class="pt-1">
            <.icon name={:information_circle} outlined class="
              text-gray-500
              flex-shrink-0 h-4 w-4
            "/>
          </div>
          <div class="">
            <p class="form-field-hint">
              <%= gettext("An Option Group can be assigned to multiple items so that you don't have to recreate options for each of the Items you offer.") %>
            </p>
          </div>
        </div>
      </div>

      <div class="mx-0">
        <div>
          <%= label f, gettext("Select items"), class: "my-2" %>
          <%=
            options = build_catalogue_item_checkboxes_options(@catalogue_items)
            multiselect_checkboxes f, :items, options,
              selected: get_selected_catalogue_items(f),
              class: ""
          %>
        </div>
      </div>

      <div class="submit-button-container">
        <%= submit gettext("Save"), phx_disable_with: gettext("Saving..."), class: "button" %>
      </div>
    <% end %>
  </div>
</div>
