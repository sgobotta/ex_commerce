<%= if connected?(@socket) do %>
  <%= if @live_action in [:new, :edit] do %>
    <%= live_modal @socket, ExCommerceWeb.CatalogueItemOptionGroupLive.FormComponent,
      id: @catalogue_item_option_group.id || :new,
      title: @page_title,
      action: @live_action,
      catalogue_items: @brand.catalogue_items,
      catalogue_item_option_group: @catalogue_item_option_group,
      return_to: Routes.catalogue_item_option_group_index_path(@socket, :index, @brand.id),
      patch_to: Routes.catalogue_item_option_group_index_path(@socket, :index, @brand.id),
      redirect_to: @redirect_to
    %>
  <% end %>

  <div class="dashboard-container">
    <h1 class="user-form section-title-lg">
      <%= gettext("My Option Groups") %>
    </h1>

    <p class="pb-2 text-lg form-field-description">
      <%= gettext("Create item option groups to accompany your offered items.") %>
    </p>

    <div class="flex flex-row pb-2">
      <div class="pt-1">
        <.icon name={:information_circle} outlined class="
          text-gray-500
          flex-shrink-0 h-4 w-4
        "/>
      </div>
      <div class="">
        <p class="form-field-hint">
          <%= gettext("These can be selected as additionals to any item that has an option group assigned to it.") %>
        </p>
      </div>
    </div>

    <div id="catalogue_item_option_groups">
      <%= for %CatalogueItemOptionGroup{id: catalogue_item_option_group_id} = catalogue_item_option_group <- @catalogue_item_option_groups do %>
        <.list_card id={"catalogue_item_option_group-#{catalogue_item_option_group_id}"}>
          <:info>
            <p class="
              text-base sm:text-lg text-black font-medium
              text-ellipsis overflow-hidden whitespace-nowrap
            ">
              <%= catalogue_item_option_group.name %>
            </p>
            <p class="
              text-base sm:text-base text-black font-normal
              text-ellipsis overflow-hidden whitespace-nowrap
            ">
              <%= catalogue_item_option_group.code %>
            </p>
          </:info>
          <:actions>
            <span class="px-2">
              <%= live_redirect to: Routes.catalogue_item_option_group_show_path(@socket, :show, @brand.id, catalogue_item_option_group_id), class: "shadow-lg transition duration-300 scale-100 active:scale-[0.98] active:shadow-none" do %>
                <.icon outlined={true} name={:eye} class="base-alert-icon pressable action text-sky-500"/>
              <% end %>
            </span>
            <span class="px-2">
              <%= live_patch to: Routes.catalogue_item_option_group_index_path(@socket, :edit, @brand.id, catalogue_item_option_group_id), id: "update" do %>
                <.icon outlined={true} name={:pencil} class="base-alert-icon pressable action text-green-500"/>
              <% end %>
            </span>
            <span class="px-2">
              <%= link to: "#", id: "delete", phx_click: "delete", phx_value_id: catalogue_item_option_group_id, data: [confirm: gettext("Are you sure?")] do %>
                <.icon outlined={true} name={:trash} class="base-alert-icon pressable action text-rose-500"/>
              <% end %>
            </span>
          </:actions>
        </.list_card>
      <% end %>
    </div>

    <.floating_button to={Routes.catalogue_item_option_group_index_path(@socket, :new, @brand.id)} />
  </div>
<% end %>
