<%= if connected?(@socket) do %>

  <%= if @live_action in [:edit] do %>
    <%= live_modal @socket, ExCommerceWeb.CatalogueItemOptionGroupLive.FormComponent,
      id: @catalogue_item_option_group.id,
      title: @page_title,
      action: @live_action,
      catalogue_items: @brand.catalogue_items,
      catalogue_item_option_group: @catalogue_item_option_group,
      return_to: Routes.catalogue_item_option_group_show_path(
        @socket,
        :show,
        @brand.id,
        @catalogue_item_option_group.id
      ),
      patch_to: Routes.catalogue_item_option_group_show_path(
        @socket,
        :show,
        @brand.id,
        @catalogue_item_option_group.id
      ),
      redirect_to: @redirect_to %>
  <% end %>

  <LiveMotion.motion
    id="show-option_group"
    initial={[y: [-1000]]}
    animate={[y: [0]]}
    transition={[]}
    exit={[y: [-1000]]}
    class="flex justify-center"
  >
    <div class="dashboard-container m-4 card flex flex-col justify-between w-full">
      <h1 class="user-form section-title-lg py-1">
        <%= @catalogue_item_option_group.name %>
      </h1>

      <div>
        <p class="
          text-base sm:text-lg text-black font-normal
          text-ellipsis overflow-hidden whitespace-nowrap
        ">
          <span class="font-semibold"><%= gettext("Code") %>:</span> <%= @catalogue_item_option_group.code %>
        </p>
        <p class="
          text-base sm:text-lg text-black font-normal
          text-ellipsis overflow-hidden whitespace-nowrap
        ">
          <span class="font-semibold"><%= gettext("Description") %>:</span> <%= @catalogue_item_option_group.description %>
        </p>
        <p class="
          text-base sm:text-lg text-black font-normal
          text-ellipsis overflow-hidden whitespace-nowrap
        ">
          <span class="font-semibold"><%= gettext("Mandatory") %>:</span> <%= if @catalogue_item_option_group.mandatory, do: gettext("Yes"), else: gettext("No") %>
        </p>
        <p class="
          text-base sm:text-lg text-black font-normal
          text-ellipsis overflow-hidden whitespace-nowrap
        ">
          <span class="font-semibold"><%= gettext("Multiple selection") %>:</span> <%= if @catalogue_item_option_group.multiple_selection, do: gettext("Yes"), else: gettext("No") %>
        </p>
        <p class="
          text-base sm:text-lg text-black font-normal
          text-ellipsis overflow-hidden whitespace-nowrap
        ">
          <span class="font-semibold"><%= gettext("Max selection") %>:</span> <%= @catalogue_item_option_group.max_selection %>
        </p>
      </div>

      <div class="flex flex-row items-center justify-between">
        <span>
          <%= live_redirect gettext("Back"), to: Routes.catalogue_item_option_group_index_path(@socket, :index, @brand.id), class: "link" %>
        </span>
        <span>
          <%= live_patch gettext("Edit"), to: Routes.catalogue_item_option_group_show_path(@socket, :edit, @brand.id, @catalogue_item_option_group), class: "button" %>
        </span>
      </div>
    </div>
  </LiveMotion.motion>
<% end %>
