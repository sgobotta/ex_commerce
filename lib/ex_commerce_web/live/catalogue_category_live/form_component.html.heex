<div>
  <div class="px-4">
    <.title_bar title={@title} />
  </div>

  <div class="px-6 py-2">
    <%= form_for @changeset, "#", [
        id: "catalogue_category-form",
        phx_target: @myself,
        phx_change: "validate",
        phx_submit: "save",
        class: "mb-0"
      ], fn f -> %>

      <%= label f, :code, gettext("Code"), class: "my-2" %>
      <%= text_input f, :code, class: "input light-bg", placeholder: gettext("An internal code: Breakfast-Category-000 / Services-Category-000") %>
      <%= error_tag f, :code %>

      <%= label f, :name, gettext("Name"), class: "my-2" %>
      <%= text_input f, :name, class: "input light-bg", placeholder: gettext("Breakfast / Repairing Services") %>
      <%= error_tag f, :name %>

      <%= label f, :description, gettext("Description"), class: "my-2" %>
      <%= text_input f, :description, class: "input light-bg", placeholder: gettext("Only available from 8 a.m. to 12 p.m. / ") %>
      <%= error_tag f, :description %>

      <div class="border-b-1 border-gray-300 my-3">
        <p class="mt-4 mb-2 section-subtitle"><%= gettext("Items") %> (<%= gettext("Optional") %>)</p>
        <p class="pb-2 text-lg form-field-description">
          <%= gettext("Assign one or more items to this category.") %>
        </p>
        <div class="flex flex-row pb-2">
          <div class="pt-1">
            <.icon name={:information_circle} outlined class="
              text-gray-500
              flex-shrink-0 h-4 w-4
            "/>
          </div>
          <div class="">
            <p class="form-field-hint">
              <%= gettext("Categories can also be assigned when creating an item.") %>
            </p>
          </div>
        </div>
      </div>

      <div class="">
        <div>
          <%= label f, gettext("Select items"), class: "my-2" %>
          <%=
            options = build_catalogue_item_options(@catalogue_items)
            multiselect_checkboxes f, :items, options,
              selected: get_selected_catalogue_items(f),
              class: ""
          %>
        </div>

        <div class="flex justify-start my-6">
          <a
            href="#"
            phx-click="create_item"
            phx-target={@myself}
            class="button"
            id="catalogue_category-add-item-input"
          >
            <%= gettext("Create an Item") %>
          </a>
        </div>
      </div>

      <div class="border-b-1 border-gray-300 my-3">
        <p class="mt-4 mb-2 section-subtitle"><%= gettext("Catalogues") %> (<%= gettext("Optional") %>)</p>
        <p class="pb-2 text-lg form-field-description">
          <%= gettext("Assign one or more catalogues to this category.") %>
        </p>
        <div class="flex flex-row pb-2">
          <div class="pt-1">
            <.icon name={:information_circle} outlined class="
              text-gray-500
              flex-shrink-0 h-4 w-4
            "/>
          </div>
          <div class="">
            <p class="form-field-hint">
              <%= gettext("Categories can also be assigned when creating a Catalogue.") %>
            </p>
          </div>
        </div>
      </div>

      <div class="">
        <div>
          <%= label f, gettext("Select catalogues"), class: "my-2" %>
          <%=
            options = build_catalogue_options(@catalogues)
            multiselect_checkboxes f, :catalogues, options,
              selected: get_selected_catalogues(f),
              class: ""
          %>
        </div>

        <div class="flex justify-start my-6">
          <a
            href="#"
            phx-click="create_catalogue"
            phx-target={@myself}
            class="button"
            id="catalogue_category-add-catalogue-input"
          >
            <%= gettext("Create a Category") %>
          </a>
        </div>
      </div>

      <div class="submit-button-container">
        <%= submit gettext("Save"), phx_disable_with: gettext("Saving..."), class: "button" %>
      </div>
    <% end %>
  </div>
</div>
