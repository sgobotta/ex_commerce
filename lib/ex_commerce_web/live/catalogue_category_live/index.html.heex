<%= if connected?(@socket) do %>
  <%= if @live_action in [:new, :edit] do %>
    <%= live_modal @socket, ExCommerceWeb.CatalogueCategoryLive.FormComponent,
      id: @catalogue_category.id || :new,
      title: @page_title,
      action: @live_action,
      catalogue_category: @catalogue_category,
      catalogue_items: @brand.catalogue_items,
      catalogues: @brand.catalogues,
      return_to: Routes.catalogue_category_index_path(@socket, :index, @brand.id),
      patch_to: Routes.catalogue_category_index_path(@socket, :index, @brand.id),
      redirect_to: @redirect_to,
      current_route: Routes.catalogue_category_index_path(
        @socket,
        @live_action,
        @brand.id,
        if @live_action == :edit do @catalogue_category.id else [] end
      )
    %>
  <% end %>

  <div class="dashboard-container">
    <h1 class="user-form section-title-lg">
      <%= gettext("My Catalogue categories") %>
    </h1>

    <p class="pb-2 text-lg form-field-description">
      <%= gettext("Create catalogue/menu categories to group up products of similar nature.") %>
    </p>
    
    <div class="flex flex-row pb-2">
      <div class="pt-1">
        <.icon name={:information_circle} outlined class="
          text-gray-500
          flex-shrink-0 h-4 w-4
        "/>
      </div>
      <div class="">
        <p class="form-field-hint">
          <%= gettext("A category can be assigned to one or more catalogues.") %>
        </p>
      </div>
    </div>

    <div id="catalogue_categories">
      <%= for %CatalogueCategory{id: catalogue_category_id} = catalogue_category <- @catalogue_categories do %>
        <.list_card id={"catalogue_category-#{catalogue_category_id}"}>
          <:info>
            <p class="
              text-base sm:text-lg text-black font-medium
              text-ellipsis overflow-hidden whitespace-nowrap
            ">
              <%= catalogue_category.name %>
            </p>
            <p class="
              text-base sm:text-base text-black font-normal
              text-ellipsis overflow-hidden whitespace-nowrap
            ">
              <%= catalogue_category.code %>
            </p>
          </:info>
          <:actions>
            <span class="px-2">
              <%= live_redirect to: Routes.catalogue_category_show_path(@socket, :show, @brand.id, catalogue_category_id), class: "shadow-lg transition duration-300 scale-100 active:scale-[0.98] active:shadow-none" do %>
                <.icon outlined={true} name={:eye} class="base-alert-icon pressable action text-sky-500"/>
              <% end %>
            </span>
            <span class="px-2">
              <%= live_patch to: Routes.catalogue_category_index_path(@socket, :edit, @brand.id, catalogue_category_id), id: "update" do %>
                <.icon outlined={true} name={:pencil} class="base-alert-icon pressable action text-green-500"/>
              <% end %>
            </span>
            <span class="px-2">
              <%= link to: "#", id: "delete", phx_click: "delete", phx_value_id: catalogue_category_id, data: [confirm: gettext("Are you sure?")] do %>
                <.icon outlined={true} name={:trash} class="base-alert-icon pressable action text-rose-500"/>
              <% end %>
            </span>
          </:actions>
        </.list_card>
      <% end %>
    </div>

    <.floating_button to={Routes.catalogue_category_index_path(@socket, :new, @brand.id)} />
  </div>
<% end %>
