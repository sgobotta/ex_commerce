<%= if connected?(@socket) do %>

  <%= if @live_action in [:edit] do %>
    <%= live_modal @socket, ExCommerceWeb.CatalogueItemLive.FormComponent,
      id: @catalogue_item.id,
      title: @page_title,
      action: @live_action,
      brand: @brand,
      catalogue_categories: @brand.catalogue_categories,
      catalogue_item: @catalogue_item,
      catalogue_item_option_groups: @brand.catalogue_item_option_groups,
      return_to: Routes.catalogue_item_show_path(@socket, :show, @brand.id, @catalogue_item.id),
      patch_to: Routes.catalogue_item_show_path(@socket, :show, @brand.id, @catalogue_item.id),
      current_route: Routes.catalogue_item_show_path(
        @socket,
        @live_action,
        @brand.id,
        if @live_action == :edit do @catalogue_item.id else [] end
      ),
      redirect_to: @redirect_to
      %>
  <% end %>

  <LiveMotion.motion
    id="catalogue-item"
    initial={[y: [-1000]]}
    animate={[y: [0]]}
    transition={[]}
    exit={[y: [-1000]]}
    class="flex justify-center"
  >

    <div class="dashboard-container m-4 card">
      <h1 class="user-form section-title-lg">
        <%= @catalogue_item.name %>
      </h1>

      <div class="lg:col-span-1 flex my-2 lg:-ml-16">
        <div class="basis-1/12 lg:basis-2/12 self-center">
        </div>
        <div class="
          basis-11/12 lg:basis-10/12
          grid grid-cols-12 grid-rows-3
          bg-white rounded-md mb-2 p-2 sm:p-4
        ">
          <div class="
            relative col-span-1 lg:col-span-2 row-span-3 self-center
            w-16 sm:w-20 md:w-24 lg:w-28 xl:w-32
            h-16 sm:h-20 md:h-24 lg:h-28 xl:h-32
          ">
            <div class="absolute -left-2/3">
              <%= for photo <- get_photos(@catalogue_item.photos, [
                use_placeholder: true,
                type: :avatar
              ]) do %>
                <%= render_image([
                  source: get_photo_source(@socket, photo),
                  size_classes: "w-16 sm:w-20 md:w-24 lg:w-28 xl:w-32 h-16 sm:h-20 md:h-24 lg:h-28 xl:h-32"
                ]) %>
              <% end %>
            </div>
          </div>
          <div class="
            col-span-10 lg:col-span-9 row-span-3 md:-ml-12 -mr-8 md:-mr-12
            flex flex-col justify-between
          ">
            <div class="">
              <p class="
                text-base sm:text-base text-black font-normal
                text-ellipsis overflow-hidden whitespace-nowrap
              ">
                <%= @catalogue_item.code %>
              </p>
            </div>
            <div class="">
              <p class="
                text-base text-gray-700
              ">
                <%= @catalogue_item.description %>
              </p>
            </div>
            <div class="flex flex-row justify-between items-center">
              <p class="
                tracking-wider font-bold text-xl text-sky-600
                text-ellipsis overflow-hidden whitespace-nowrap
              ">
                <%= get_item_price(@catalogue_item.variants) %>
              </p>
              <%= live_patch gettext("Edit"), to: Routes.catalogue_item_show_path(@socket, :edit, @brand.id, @catalogue_item.id), class: "button" %>
            </div>
          </div>
        </div>
      </div>

      <span><%= live_redirect gettext("Back"), to: Routes.catalogue_item_index_path(@socket, :index, @brand.id), class: "link" %></span>

    </div>
  </LiveMotion.motion>
<% end %>
