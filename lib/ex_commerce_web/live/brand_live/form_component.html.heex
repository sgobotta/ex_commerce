<div>

  <div class="px-4">
    <.title_bar title={@title} />
  </div>

  <div class="px-6 py-2">
    <%= form_for @changeset, "#", [
        id: "brand-form",
        phx_target: @myself,
        phx_change: "validate",
        phx_submit: "save",
        class: "mb-0"
      ],
      fn f -> %>

      <%= label f, :name, gettext("Name"), class: "my-2" %>
      <%= text_input f, :name, class: "input light-bg", placeholder: gettext("My brand name")  %>
      <%= error_tag f, :name %>

      <div class="">
        <%= label f, :slug, gettext("Slug"), class: "my-2" %>
        <div class="mt-1 flex rounded-lg shadow-sm">
          <span class="
            inline-flex items-center
            px-3 rounded-l-lg
            border border-r-0 border-gray-300
            bg-gray-50
            text-gray-500 text-lg
          ">
            <%= URI.parse(ExCommerceWeb.Endpoint.url()).host %>/
          </span>
          <%= text_input f, :slug, class: "input-slug light-bg" %>
          <%= error_tag f, :slug %>
        </div>
      </div>

      <div class="flex justify-end mt-6">
        <%= submit gettext("Save"), phx_disable_with: gettext("Saving..."), class: "button" %>
      </div>
    <% end %>
  </div>

</div>
